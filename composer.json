{
	"name": "phpbbmodders/feedlinks",
	"type": "phpbb-extension",
	"description": "Adds RSS 2.0 versions of phpBB's Atom feeds and shows Atom, RSS or both feed links on the forums you choose.",
	"homepage": "https://www.phpbbmodders.com/",
	"version": "1.0.0-dev",
	"keywords": [
		"phpbb",
		"extension",
		"feed",
		"rss",
		"atom"
	],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "phpBB Modders",
			"email": "board@phpbbmodders.com",
			"homepage": "https://www.phpbbmodders.com/",
			"role": "Extension Developer"
		}
	],
	"require": {
		"php": ">=7.4",
		"ext-dom": "*",
		"composer/installers": "^1.0 || ^2.0"
	},
	"extra": {
		"display-name": "Feed Links",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.19,<4.1.0@dev"
		}
	}
}
